---
/**
 * Case-scoping intake.
 *
 * Rendered on demand so it can reflect submission state back to the visitor;
 * the landing page remains prerendered. See sites/www/src/pages/contact.astro
 * for the same reasoning.
 *
 * Deliberately short. A litigator evaluating an unfamiliar expert will abandon
 * a long form, and everything not asked here can be asked in the reply. Only
 * name, email and what the dispute turns on are required.
 *
 * The confidentiality note is not boilerplate. Free-text description of a live
 * matter can carry privileged or client-identifying detail, which creates a
 * conflict-check problem before any engagement exists. Asking submitters to
 * withhold it is both better practice and less exposure in the database.
 *
 * The form requires JavaScript, because the Turnstile widget will not render
 * without it and the endpoint rejects a submission carrying no token. The
 * noscript block is the fallback.
 */
export const prerender = false

import { env } from 'cloudflare:workers'
import Layout from '../layouts/Layout.astro'
import copy from '../copy/landing'
import { ENGAGEMENT_TYPES } from '../lib/form'

const params = Astro.url.searchParams
const sent = params.get('sent') === '1'
const error = params.get('error')

const errorMessage =
  error === 'invalid'
    ? 'Please provide your name, a valid email address, and a short description of the matter.'
    : error === 'captcha'
      ? // Not phrased as a failed check. Turnstile tokens are single-use and
        // last 300 seconds, so a stale form is the likeliest cause and none of
        // it is the submitter's doing.
        `That form had expired. Please reload the page and send it again, or email ${copy.contact.email}.`
      : error === 'server'
        ? `Something went wrong saving your enquiry. Please email ${copy.contact.email} instead.`
        : null

const turnstileSiteKey = env.TURNSTILE_SITE_KEY
---

<Layout
  title="Scope a case | Root System Forensics"
  description="Start with a fixed-fee technical assessment — source code, data and metadata, system failure, or a model. Tell us what the matter turns on."
>
  <div class="wrap page">
    <p class="eyebrow">Scope a case</p>

    {
      sent ? (
        <div class="measure">
          <h1>Thanks — that's with us.</h1>
          <p>
            {copy.contact.responseTime} If it's time-critical,{' '}
            <a href={`mailto:${copy.contact.email}`}>{copy.contact.email}</a>{' '}
            reaches us fastest.
          </p>
          <p class="fineprint">
            Nothing in this enquiry creates an engagement or an attorney-expert
            relationship, and no conflicts check has been performed yet.
          </p>
        </div>
      ) : (
        <div class="measure">
          <h1>Scope a case</h1>
          <p class="lede">
            Start with the fixed-fee assessment — $2,500, capped at ten hours,
            credited against a full engagement if the matter proceeds. Tell us
            what the dispute turns on. {copy.contact.responseTime}
          </p>

          <p class="confidentiality">
            <strong>Please don't include privileged or client-identifying
            detail at this stage.</strong> A general description of the
            technical question is enough to scope the work, and keeps both of us
            clear of a conflicts problem before one exists.
          </p>

          {/* The conflict rule stated before the form rather than after it.
              Root System also builds AI systems for clients, and counsel
              deciding whether to describe a live matter to an unfamiliar expert
              should know how that is handled first. Links to the full sequence
              on /engagements rather than restating it. */}
          <p class="fineprint">
            Nothing here creates an engagement yet. Every intake opens with a
            written conflict screen, and an NDA is executed before any
            confidential material moves — <a href="/engagements/#process">how an
            engagement starts</a>.
          </p>

          {errorMessage && <p class="notice error">{errorMessage}</p>}

          <form method="post" action="/api/intake">
            <label for="name">Name <span>required</span></label>
            <input id="name" name="name" type="text" required maxlength="120" autocomplete="name" />

            <label for="email">Email <span>required</span></label>
            <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" />

            <label for="firm">Firm</label>
            <input id="firm" name="firm" type="text" maxlength="200" autocomplete="organization" />

            <label for="engagement_type">What kind of help are you after?</label>
            <select id="engagement_type" name="engagement_type">
              {ENGAGEMENT_TYPES.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>

            <label for="summary">
              What does the dispute turn on, technically? <span>required</span>
            </label>
            <textarea id="summary" name="summary" rows="7" required maxlength="5000"></textarea>

            <label for="timing">Any deadline we should know about?</label>
            <input id="timing" name="timing" type="text" maxlength="300" placeholder="Expert reports due in three weeks, no deadline yet, …" />

            <label for="referral">How did you hear about us?</label>
            <input id="referral" name="referral" type="text" maxlength="300" />

            {/* Honeypot — off-screen rather than display:none, which some bots
                know to skip. */}
            <div class="decoy" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            {/* Implicit rendering: the script finds this container and injects
                the cf-turnstile-response input into the enclosing form. */}
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>

            <noscript>
              <p class="notice error">
                This form needs JavaScript to verify the submission. Please
                email <a href={`mailto:${copy.contact.email}`}>{copy.contact.email}</a>{' '}
                instead.
              </p>
            </noscript>

            <button type="submit">Send enquiry</button>
          </form>

          {/* is:inline so Astro leaves the async/defer attributes alone. */}
          <script
            is:inline
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer
          ></script>

          <p class="alt">
            Prefer email? <a href={`mailto:${copy.contact.email}`}>{copy.contact.email}</a>
          </p>
        </div>
      )
    }
  </div>
</Layout>

<style>
  .page {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  h1 {
    font-size: clamp(1.875rem, 4vw, 2.75rem);
  }

  .lede {
    font-size: 1.0625rem;
  }

  .confidentiality {
    background: var(--code-bg);
    border-left: 3px solid var(--accent);
    padding: 1rem 1.25rem;
    font-size: 0.9375rem;
    margin: 2rem 0;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    margin-top: 1.25rem;
  }

  label span {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  input,
  select,
  textarea {
    font: inherit;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.625rem 0.75rem;
    width: 100%;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: var(--accent);
  }

  /* The widget sizes itself; this only separates it from the last field. It
     reserves no height, so the page shifts slightly when the widget loads. */
  .cf-turnstile {
    margin-top: 1.75rem;
  }

  button {
    font: inherit;
    font-weight: 600;
    align-self: flex-start;
    margin-top: 1.75rem;
    background: var(--accent);
    color: var(--bg);
    border: 0;
    border-radius: 6px;
    padding: 0.75rem 1.5rem;
    cursor: pointer;
  }

  button:hover {
    background: var(--accent-2);
  }

  .decoy {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .notice.error {
    border-left: 3px solid var(--danger);
    padding: 0.75rem 1rem;
    background: var(--fill);
  }

  .alt,
  .fineprint {
    margin-top: 2rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
