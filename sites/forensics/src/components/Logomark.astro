    <path d="M291.7,127a4,4,0,0,0,.5-5.6L266.6,90.9a6.47,6.47,0,0,0-.8-.9,4,4,0,0,0-5.6.5L247.9,105a4,4,0,0,0,6.1,5.1l9.1-10.9L286,126.5a4.1,4.1,0,0,0,3.1,1.4A3.92,3.92,0,0,0,291.7,127Z" />
    <path d="M249,198.2a4,4,0,0,0,.5-5.6l-46.3-55.1a3.63,3.63,0,0,0-3.1-1.4,4.1,4.1,0,0,0-3.1,1.4l-46.3,55.1a4,4,0,0,0,6.1,5.1l43.3-51.6,43.3,51.6a4.1,4.1,0,0,0,3.1,1.4A4.26,4.26,0,0,0,249,198.2Z" />
