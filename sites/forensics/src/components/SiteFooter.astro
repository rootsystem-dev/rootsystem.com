---
/**
 * Shared footer. Rendered once by Layout.astro, after </main>, so it is a
 * contentinfo landmark on every route rather than a generic element nested
 * inside main.
 */
import copy from '../copy/landing'
---

<footer class="wrap">
  <p>
    {copy.contact.footer} ·{' '}
    <a href={`mailto:${copy.contact.email}`}>{copy.contact.email}</a>
  </p>
  {/* The footer line already ends on a name. Before the profiles existed it
      was the only place on the property that named anyone, and it went
      nowhere. */}
  <p>
    <a href={`/experts/${copy.experts[0].slug}/`}>
      {copy.experts[0].name} — credentials and background
    </a>
  </p>
  {/* The intake form takes a written description of a live matter, so the
      policy governing what happens to it has to be reachable from the page
      the form is on -- which, since this footer renders on every route, it
      now is. */}
  <p><a href="/privacy/">Privacy policy</a></p>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding-top: 2rem;
    padding-bottom: 3rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
