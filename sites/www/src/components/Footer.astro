---
// Assumes the current year is fine to compute at build time — the site is
// static and rebuilds often enough that a stale year is not a real risk.
const year = new Date().getFullYear()
---

<footer>
  <p>&copy; {year} Root System</p>
</footer>

<style>
  footer {
    max-width: var(--page-max);
    margin: 4rem auto 0;
    padding: 1.5rem;
    border-top: 1px solid var(--rule);
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }

  footer p {
    margin: 0;
  }
</style>
