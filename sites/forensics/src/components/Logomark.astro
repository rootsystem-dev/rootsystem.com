---
/**
 * Root System logomark, ported from sites/www/src/components/Logomark.astro.
 * The path data and the viewBox crop are byte-identical, so both properties
 * render the same mark; only the colour plumbing differs, because forensics
 * names its tokens --ink and --accent where the main site uses --fg and --link.
 *
 * The old component resolved three Chakra tokens at runtime — green.500 for the
 * branches, gray.700 for the roots and nodes, and white for everything in dark
 * mode. Here those become two custom properties set by CSS, so the mark needs
 * no JavaScript and cannot flash the wrong colour before hydration.
 *
 * Decorative: every use so far pairs it with the "Root System" wordmark, so the
 * accessible name already exists in the adjacent text and this is hidden from
 * assistive tech. If it is ever used alone, give that instance a label.
 *
 * The viewBox is cropped to the artwork rather than left at the original
 * `0 0 400 400`. The mark occupies x 76-324 and y 46-354 of that square, so the
 * old component rendered ~19% dead space on every side and any gap next to the
 * wordmark was really that padding. `76 46 248 308` is the same crop as the
 * brand folder's SVG/Asset exports (`0 0 248 308.01`, the identical paths
 * translated by -76,-46) — but taken here without switching to those files,
 * which are flattened to monochrome white and would lose the green.
 *
 * Because the crop is portrait, height drives the size and width follows.
 */
interface Props {
  /** Rendered height. 3rem matches the old 4rem square's visible artwork. */
  size?: string
  class?: string
}

const { size = '3rem', class: className } = Astro.props
---

<svg
  class:list={['logomark', className]}
  viewBox="76 46 248 308"
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <g class="branches">
