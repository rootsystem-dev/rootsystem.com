---
/**
 * Site masthead for forensics.rootsystem.com.
 *
 * Metrics are matched to sites/www/src/components/Header.astro so the two
 * properties read as one brand: 0.75rem padding rising to 1.75rem from 48em,
 * the wordmark in Tiempos 700 / -0.025em, and nav at --text-sm, uppercase,
 * weight 400, 1.5rem gap.
 *
 * Inline nav from 48em; below that the links collapse behind a hamburger. The
 * spec originally rejected a hamburger outright, on the grounds that a
 * property arguing reproducibility should not need a script to show its own
 * menu. The collapse was asked for after seeing three stacked rows of chrome
 * on a phone, and a <details> disclosure satisfies both: still no JavaScript,
 * and the links stay in the served HTML at every width, so a crawler reads
 * what a desktop reader reads.
 *
 * The call to action is suppressed on /scope, where the reader has already
 * arrived. The nav links stay: a form page with no way out is a trap, and a
 * reader wanting to check the method first needs a route to it.
 */
import Logomark from './Logomark.astro'

// Experts sits ahead of Engagements deliberately. A retaining attorney
// reviewing this property said the credentials were what they looked for
// first and could not find them, which is the whole reason the route exists;
// putting it behind the fee page would repeat the problem more quietly.
const links = [
  { href: '/method/', label: 'Method' },
  { href: '/matters/', label: 'Matters' },
  { href: '/experts/', label: 'Experts' },
  { href: '/engagements/', label: 'Engagements' },
]

// startsWith rather than ===: Astro serves these routes with a trailing slash,
// so an equality test against the href would never match. This is true once for
// the whole component, which is why it is a note here rather than a comment
// wrapping every rendered link.
const path = Astro.url.pathname
const onScope = path.startsWith('/scope')
---

<header>
  <div class="bar">
    <a class="brand" href="/">
      <Logomark size="2.5rem" />
      <span class="lockup">
        <span class="wordmark">Root System</span>
        <span class="qualifier">Forensics</span>
      </span>
    </a>
    <nav aria-label="Primary">
      <details class="disclosure">
        <summary>
          <span class="bars" aria-hidden="true"></span>
          Menu
        </summary>
        <div class="links">
          {
            links.map(({ href, label }) => (
              <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
          {!onScope && <a class="cta" href="/scope">Scope a case &rarr;</a>}
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  /*
   * `header` spans the viewport so a rule could reach both edges; `.bar` holds
   * the row at content width. Same two-element split as the main site's.
   *
   * The gutter belongs on `.bar`, not on `header`. With the inline padding on
   * the full-width header, `.bar`'s `margin: 0 auto` centred it inside the
   * already-inset box, so the brand lockup landed at the viewport's centring
   * offset while every `.wrap` below landed at that offset plus the gutter —
   * the masthead sat 28px left of the page content. Putting the gutter inside
   * the centred box reproduces `.wrap`'s geometry exactly.
   */
  header {
    padding-block: 0.75rem;
    /* Positioning context for the narrow-width menu panel below. */
    position: relative;
  }

  @media (min-width: 48em) {
    header {
      padding-block: 1.75rem;
    }
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }

  .lockup {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .wordmark {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  @media (min-width: 48em) {
    .wordmark {
      font-size: var(--text-2xl);
    }
  }

  .qualifier {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .brand:hover,
  .brand:focus-visible {
    color: var(--accent);
  }

  nav {
    font-size: var(--text-sm);
  }

  /*
   * The narrow-width menu is a <details> disclosure, not a scripted dropdown.
   *
   * The spec rejected a hamburger to avoid a JavaScript dependency on a
   * property whose argument is reproducibility. A disclosure honours both: the
   * links sit in the served HTML at every viewport and are only visually
   * collapsed, so a crawler reads the same markup a desktop reader does, and
   * <summary> is focusable and toggles on Enter/Space with no script.
   */
  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    padding: 0.5rem 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--body);
    /* Both are needed: `list-style` covers Firefox, the pseudo-element covers
       older WebKit. Without them the default triangle sits beside the bars. */
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  summary:focus-visible {
    color: var(--accent);
  }

  /* Three bars from one element: the middle is the box, the outer two are its
     pseudo-elements. They rotate into a cross when the disclosure is open. */
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 1.125rem;
    height: 2px;
    background: currentColor;
    transition: transform 120ms ease, background-color 120ms ease;
  }

  .bars {
    position: relative;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .bars::before {
    top: -6px;
  }

  .bars::after {
    top: 6px;
  }

  details[open] .bars {
    background: transparent;
  }

  details[open] .bars::before {
    top: 0;
    transform: rotate(45deg);
  }

  details[open] .bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /*
   * The open menu is a panel positioned against the header, not an inline
   * block inside nav. Inline, opening it widened nav enough to wrap onto its
   * own row, which shunted the toggle from the right edge to the left and grew
   * the header from 64px to 307px — the toggle moved out from under the thumb
   * that had just tapped it. Taking the panel out of flow keeps the header a
   * fixed height in both states.
   */
  .links {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 0.5rem var(--gutter) 1rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  @media (prefers-reduced-motion: reduce) {
    .bars,
    .bars::before,
    .bars::after {
      transition: none;
    }
  }

  /*
   * From 48em the disclosure stops being one: the toggle is removed from the
   * accessibility tree along with the box, and the links lay out inline as an
   * ordinary nav.
   *
   * Two declarations force the content open because browsers hide a closed
   * <details> two different ways. Firefox and Safari hide the slotted content
   * with `display`, which an author rule can override. Chrome 131+ uses
   * `content-visibility: hidden` on `::details-content`, which `display`
   * cannot reach. Setting both covers every engine; dropping either leaves the
   * desktop nav invisible on some of them.
   */
  @media (min-width: 48em) {
    summary {
      display: none;
    }

    .links {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
      padding: 0;
      background: none;
      border-bottom: 0;
    }

    .disclosure::details-content {
      content-visibility: visible;
    }
  }

  /* --body rather than --muted: at 14px/400 the muted token is 3.67:1 on white,
     under the 4.5:1 AA floor. The main site's header uses a darker muted token
     that clears it; matching its metrics without matching its contrast was the
     bug. --ink on aria-current keeps the active route distinct. */
  nav a {
    color: var(--body);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.5rem 0;
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: var(--ink);
  }

  /* Astro scopes these with an attribute, which outranks the global `a:hover`
     in base.css -- without them the nav links have no hover colour at all.
     The [aria-current] variant is restated for the same reason. */
  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current='page']:hover,
  nav a[aria-current='page']:focus-visible {
    color: var(--accent);
  }

  /* The CTA keeps .cta's fill from base.css, so only the metrics differ. */
  nav a.cta {
    color: var(--bg);
    padding: 0.5rem 1rem;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 600;
  }

  nav a.cta:hover,
  nav a.cta:focus-visible {
    color: var(--bg);
  }
</style>
