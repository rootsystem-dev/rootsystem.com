---
// Copy is carried over verbatim from the previous site (spec decision D6 —
// this is a stack change, not a repositioning). Any rewrite of the main-brand
// positioning is separate work with its own messaging input.
import Base from '../layouts/Base.astro'
---

<Base
  title="Root System — A sweat equity company"
  description="We're a team of founders and startup veterans who love supporting early-stage entrepreneurs and their teams."
>
  <section class="hero">
    <h1>A sweat equity company</h1>
    <p class="lede">
      We're a team of founders and startup veterans who love supporting
      early-stage entrepreneurs and their teams.
    </p>
    <p class="actions">
      <a href="/about">Learn more</a>
      <a href="/contact">Get in touch</a>
    </p>
  </section>
</Base>

<style>
  /* Top padding follows the old home page's `pt={{ base: 12, md: 40 }}` — 3rem
     on small screens, 10rem from md up. That space, not a rule under the header,
     is what separated the nav from the headline on the previous site. */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 0 4rem;
  }

  @media (min-width: 48em) {
    .hero {
      padding-top: 10rem;
    }
  }

  h1 {
    font-size: var(--text-5xl);
  }

  .lede {
    max-width: var(--measure);
    color: var(--fg-muted);
    font-size: var(--text-lg);
  }

  /* Sized to the old home page's CTAs: `fontSize="md"` (0.9375rem),
     `fontWeight="bold"`, and mr/ml of 2 on each link — a 1rem gap between. */
  .actions {
    display: flex;
    gap: 1rem;
    font-size: var(--text-md);
    font-weight: 700;
  }
</style>
