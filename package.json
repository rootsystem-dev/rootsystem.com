{
  "name": "rootsystem.com",
  "version": "3.0.0",
  "repository": "git@github.com:rootsystem-dev/rootsystem.com.git",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "sites/*",
    "workers/*"
  ],
  "scripts": {
    "dev:www": "yarn workspace @rootsystem/www dev",
    "dev:forensics": "yarn workspace @rootsystem/forensics dev",
    "build": "yarn workspaces foreach --all --topological run build",
    "build:www": "yarn workspace @rootsystem/www build",
    "build:forensics": "yarn workspace @rootsystem/forensics build",
    "check": "yarn workspaces foreach --all --topological run check"
  }
}
