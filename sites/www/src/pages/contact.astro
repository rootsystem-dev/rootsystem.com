---
// Ported from pages/contact/index.jsx (spec decision D6), same Typeform.
//
// The original used @typeform/embed-react, which pulled React into the page for
// what is ultimately an iframe. Astro ships no client JS by default and there
// is no other React on this site, so the form is embedded directly. Same form
// (id l35rkhJK), no third-party script, no hydration.
import Base from '../layouts/Base.astro'

const TYPEFORM_ID = 'l35rkhJK'
---

<Base
  title="Contact Us | Root System"
  description="Questions, feedback, or just saying hello? Let's chat."
>
  <h1 class="page-title">Contact</h1>

  <div class="form-wrap">
    <iframe
      src={`https://form.typeform.com/to/${TYPEFORM_ID}?typeform-embed=embed-widget&embed-hide-footer=true&embed-hide-headers=true#source=rootsystem.com`}
      title="Contact form"
      loading="lazy"
      allow="camera; microphone; autoplay; encrypted-media;"
    ></iframe>
  </div>

  <p class="fallback prose">
    Trouble with the form? Email us at
    <a href="mailto:partners@rootsystem.com">partners@rootsystem.com</a>.
  </p>
</Base>

<style>
  .form-wrap {
    max-width: var(--measure);
    margin: 0 auto;
  }

  iframe {
    width: 100%;
    height: 400px;
    border: 0;
  }

  /* The original set 600px on md and up via a breakpoint hook; same intent,
     expressed as a media query so it needs no JavaScript. */
  @media (min-width: 48em) {
    iframe {
      height: 600px;
    }
  }

  .fallback {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
</style>
