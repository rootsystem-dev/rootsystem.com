---
/**
 * The method spoke: why an opinion from this practice holds up, and what the
 * alternatives leave out. Pillars at full length plus the contrast table.
 */
import Layout from '../layouts/Layout.astro'
import copy from '../copy/landing'
import Pillars from '../components/Pillars.astro'
import Bench from '../components/Bench.astro'
import Contrast from '../components/Contrast.astro'
---

<Layout title={copy.routes.method.title} description={copy.routes.method.description}>
  <header class="wrap page-head">
    <h1 class="measure">{copy.routes.method.heading}</h1>
  </header>

  <Pillars form="full" />
  <Bench />
  <Contrast />

  <section class="wrap closing">
    <h2 class="measure">{copy.closing.headline}</h2>
    <a class="cta" href="/scope">{copy.closing.button} &rarr;</a>
    <p class="back"><a href="/">Back to the overview</a></p>
  </section>
</Layout>

<style>
  /* padding-block, not the `padding: 4rem 0 1rem` shorthand: this element also
     carries .wrap, and the shorthand's implicit 0 for the inline axis beat
     .wrap's padding-left on specificity (Astro scopes this rule to 0,2,0), so
     the heading hung 28px left of every section below it. */
  .page-head {
    padding-block: 2.5rem 0.5rem;
  }

  @media (min-width: 48em) {
    .page-head {
      padding-block: 4rem 1rem;
    }
  }

  .closing {
    padding-bottom: 5rem;
  }

  .back {
    margin: 2rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
</style>
