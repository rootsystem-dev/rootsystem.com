---
/**
 * The forensics root page.
 *
 * Composition plus the hero. Section copy lives in src/copy/landing; the
 * expansion-link labels and the hero's own styles are here, because they are
 * chrome for this page rather than argument copy shared with the spokes.
 *
 * Section order changed 2026-08-11. What we take (PracticeAreas) and how you
 * engage (Services) now sit directly under the hero, ahead of the positioning
 * argument and the pillars. A paralegal reviewing the site read the AI/ML-led
 * opening as an AI/ML-only practice and named the matters it would turn away,
 * and asked separately for the four modes to land near the first thing the eye
 * reads. Both notes are answered by lifting the concrete blocks above the
 * argument rather than by softening the argument.
 *
 * The note lives here rather than as a JSX comment beside the components: a
 * JSX comment inside an Astro template is fragile enough near conditional
 * branches that the convention in this codebase is to keep prose in frontmatter.
 */
import Layout from '../layouts/Layout.astro'
import copy from '../copy/landing'
import Positioning from '../components/Positioning.astro'
import PracticeAreas from '../components/PracticeAreas.astro'
import Pillars from '../components/Pillars.astro'
import CaseStudy from '../components/CaseStudy.astro'
import Services from '../components/Services.astro'
import Pricing from '../components/Pricing.astro'
import ExpandLink from '../components/ExpandLink.astro'

const scopeHref = '/scope'
---

<Layout title={copy.meta.title} description={copy.meta.description} publishesRates>
  <header class="wrap hero">
    <p class="eyebrow">{copy.hero.eyebrow}</p>
    <h1>{copy.hero.headline}</h1>
    <p class="subhead measure">{copy.hero.subhead}</p>
    <dl class="proof measure">
      {
        copy.hero.proof.map((step) => (
          <div>
            <dt>{step.label}</dt>
            <dd>{step.text}</dd>
          </div>
        ))
      }
    </dl>
    <a class="cta" href={scopeHref}>{copy.hero.cta} &rarr;</a>
  </header>

  <PracticeAreas form="summary">
    <ExpandLink href="/matters/" label="The matters we take" />
  </PracticeAreas>

  <Services form="summary">
    <ExpandLink href="/engagements/" label="How we work" />
  </Services>

  <Positioning />

  <Pillars form="summary">
    <ExpandLink href="/method/" label="The full method" />
  </Pillars>

  <CaseStudy form="summary">
    <ExpandLink href="/matters/" label="Read the matter" />
  </CaseStudy>

  <Pricing form="summary">
    <ExpandLink href="/engagements/" label="Fees and objections" />
  </Pricing>

  <section class="wrap closing">
    <h2 class="measure">{copy.closing.headline}</h2>
    <p class="measure">{copy.closing.body}</p>
    <a class="cta" href={scopeHref}>{copy.closing.button} &rarr;</a>
  </section>
</Layout>

<style>
  /* padding-block, not the `padding: 5rem 0 4rem` shorthand. The hero also
     carries .wrap, and the shorthand's implicit 0 for the inline axis won on
     specificity, pulling the hero 28px left of the sections below it. */
  .hero {
    padding-block: 3rem 2.5rem;
  }

  @media (min-width: 48em) {
    .hero {
      padding-block: 5rem 4rem;
    }
  }

  .subhead {
    font-size: 1.1875rem;
    color: var(--body);
  }

  .closing {
    padding-bottom: 5rem;
  }
</style>
