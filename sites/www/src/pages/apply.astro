---
// Copy ported verbatim from pages/apply/index.jsx (spec decision D6).
//
// The original imported a TypeformModal component but rendered no control that
// opened it -- the only live call to action in the visible copy is the
// apply@rootsystem.com address. The unused modal is not carried over.
import Base from '../layouts/Base.astro'
---

<Base
  title="Apply | Root System"
  description="Apply to work at Root System!"
>
  <h1 class="page-title">Join our team!</h1>

  <div class="prose">
    <h2>About you:</h2>
    <ul>
      <li>You're a software engineer, product manager, or growth hacker.</li>
      <li>
        You're interested in working fractionally, for an early-stage company –
        or two!
      </li>
      <li>
        You are curious about earning diversified equity in companies across our
        portfolio – not just the one you're working on.
      </li>
      <li>
        Perhaps you're a freelancer, and you're willing to take a lower cash rate
        (or even forgo cash entirely) to get more equity.
      </li>
    </ul>

    <h2>About us:</h2>
    <ul>
      <li>
        We're a group of veteran engineering &amp; product leaders who have spent
        our careers building early stage startups.
      </li>
      <li>
        We're also a venture firm with a portfolio of early stage startups, some
        of whom are looking to hire someone like you.
      </li>
      <li>We're hiring! 😄</li>
      <li>
        Just send a cover letter and some combination of a résumé, a portfolio,
        and links to your GitHub/LinkedIn to:{' '}
        <strong><a href="mailto:apply@rootsystem.com">apply@rootsystem.com</a></strong>
      </li>
    </ul>
  </div>
</Base>
