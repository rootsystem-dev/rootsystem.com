{
  "extends": "astro/tsconfigs/strict",
  // worker-configuration.d.ts is generated by `wrangler types` and declares the
  // `cloudflare:workers` module plus a typed Env for the bindings in
  // wrangler.jsonc. Regenerate it after changing bindings. It is checked in so
  // that a fresh clone typechecks without needing Cloudflare credentials.
  "include": [".astro/types.d.ts", "worker-configuration.d.ts", "**/*"],
  "exclude": ["dist"]
}
